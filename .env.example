# =============================================================================
# Verbio — environment variables (template)
# Copy to .env.local at the relevant scope and fill in real values.
# Never commit a populated .env. CI verifies presence at boot; missing vars fail fast.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info                              # debug | info | warn | error
TICK_INTERVAL_MS=500                        # 2 Hz default (brief §6)

# -----------------------------------------------------------------------------
# Railway Postgres — engine writes via SQLAlchemy async; web reads via Prisma
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/verbio?sslmode=require
DATABASE_URL_POOLED=postgresql://postgres:<password>@<host>:6543/verbio?sslmode=require  # pgBouncer (transaction mode) for serverless paths
DATABASE_URL_ENGINE=postgresql+asyncpg://verbio_engine:<password>@<host>:5432/verbio    # engine role with table grants only (no SUPERUSER)

# -----------------------------------------------------------------------------
# Auth.js v5 — session strategy, signing secret, base URL
# -----------------------------------------------------------------------------
AUTH_SECRET=                                # `openssl rand -base64 32`; rotated quarterly
AUTH_URL=http://localhost:3000              # canonical origin per environment
AUTH_TRUST_HOST=true                        # required on Railway behind upstream proxy
AUTH_SESSION_MAX_AGE=2592000                # 30-day refresh window

# Resend — transactional + magic-link delivery
RESEND_API_KEY=
AUTH_EMAIL_FROM="Verbio <no-reply@verbio.app>"

# -----------------------------------------------------------------------------
# Cloudflare R2 — S3-compatible recording + export storage
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_RECORDINGS=verbio-recordings
R2_BUCKET_EXPORTS=verbio-exports
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE=                             # optional CDN origin for signed-URL hostnames
R2_SIGNED_URL_TTL_RECORDINGS_SEC=900        # 15 min
R2_SIGNED_URL_TTL_EXPORTS_SEC=3600          # 60 min

# -----------------------------------------------------------------------------
# Redis — command bus + decision pub/sub
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=verbio                      # prefix for streams/channels

# -----------------------------------------------------------------------------
# LiveKit Cloud — SFU + agent connection
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://<project>.livekit.cloud

# -----------------------------------------------------------------------------
# Deepgram — streaming STT (Nova-3)
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general
DEEPGRAM_LANGUAGE=en-US

# -----------------------------------------------------------------------------
# Anthropic — mouth layer (Claude Haiku default, Sonnet upgrade per study)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_UPGRADE=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=120                    # one-sentence outputs only
ANTHROPIC_TIMEOUT_MS=800                    # falls back to templated phrasing if exceeded

# -----------------------------------------------------------------------------
# TTS — Cartesia (primary) + ElevenLabs (fallback)
# -----------------------------------------------------------------------------
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-english
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5

# -----------------------------------------------------------------------------
# Engine service — internal endpoint + admin auth
# -----------------------------------------------------------------------------
VERBIO_ENGINE_URL=http://localhost:8000
VERBIO_ENGINE_ADMIN_TOKEN=                  # shared secret for internal admin endpoints
VERBIO_ENGINE_PORT=8000

# -----------------------------------------------------------------------------
# Observability — Sentry + OpenTelemetry
# -----------------------------------------------------------------------------
SENTRY_DSN_WEB=
SENTRY_DSN_ENGINE=
SENTRY_ENVIRONMENT=development              # development | staging | production
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME_WEB=verbio-web
OTEL_SERVICE_NAME_ENGINE=verbio-engine
OTEL_RESOURCE_ATTRIBUTES=service.namespace=verbio,deployment.environment=development

# -----------------------------------------------------------------------------
# Storage retention (per-study policy can override at runtime)
# -----------------------------------------------------------------------------
DEFAULT_RECORDING_RETENTION_DAYS=90
DEFAULT_TRANSCRIPT_RETENTION_DAYS=365
DEFAULT_STATE_SNAPSHOT_RETENTION_DAYS=30    # downsampled to 1Hz after this

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
FEATURE_TOPIC_DRIFT_RULE=true               # rule disabled if false
FEATURE_STALLED_THREAD_RULE=false           # phase 5 deferred
FEATURE_RESEARCHER_WHISPER=true
