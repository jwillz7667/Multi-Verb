# =============================================================================
# Verbio — .gitattributes
# Enforce LF line endings everywhere; mark generated files and binaries.
# =============================================================================

# Auto-detect text files and normalize to LF on commit
* text=auto eol=lf

# -----------------------------------------------------------------------------
# Explicit text declarations
# -----------------------------------------------------------------------------
*.ts        text diff=typescript
*.tsx       text diff=typescript
*.js        text
*.jsx       text
*.mjs       text
*.cjs       text
*.json      text
*.jsonc     text
*.md        text diff=markdown
*.mdx       text
*.yml       text
*.yaml      text
*.toml      text
*.py        text diff=python
*.sql       text diff=sql
*.css       text diff=css
*.scss      text diff=css
*.html      text diff=html
*.sh        text eol=lf
*.env.example text
Dockerfile  text
*.dockerfile text

# -----------------------------------------------------------------------------
# Lockfiles — generated, exclude from diff noise
# -----------------------------------------------------------------------------
pnpm-lock.yaml      linguist-generated=true -diff
uv.lock             linguist-generated=true -diff
package-lock.json   linguist-generated=true -diff
yarn.lock           linguist-generated=true -diff
Cargo.lock          linguist-generated=true -diff

# -----------------------------------------------------------------------------
# Generated files (do not show as authored code in PR diff stats)
# -----------------------------------------------------------------------------
**/generated/**     linguist-generated=true
*.generated.ts      linguist-generated=true
*.generated.tsx     linguist-generated=true
*.generated.py      linguist-generated=true
*.generated.json    linguist-generated=true

# -----------------------------------------------------------------------------
# Binary files
# -----------------------------------------------------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.avif      binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.tgz       binary
*.mp3       binary
*.mp4       binary
*.wav       binary
*.ogg       binary
*.opus      binary
*.flac      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary

# -----------------------------------------------------------------------------
# Export-ignore (excluded from git archive tarballs)
# -----------------------------------------------------------------------------
.github/        export-ignore
.vscode/        export-ignore
.editorconfig   export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
docs/           export-ignore
