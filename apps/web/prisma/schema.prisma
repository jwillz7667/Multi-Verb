// Verbio web — Prisma schema.
//
// Alembic (services/engine/, infra/postgres/migrations/) is the
// authoritative DDL source for the Railway Postgres database. This
// file is the introspected mirror that Prisma needs to generate a
// typed client for the Next.js app.
//
// To refresh it after an Alembic migration changes the schema:
//   pnpm --filter @verbio/web db:pull
//
// The starter contents below are the Auth.js v5 tables that the app
// needs to authenticate; they match the shapes created by
// infra/postgres/migrations/versions/*_auth_js_tables.py.

// Generate into src/ so pnpm's strict node_modules symlinking doesn't
// hide the client (Prisma's default `.prisma/client` location lives
// inside the @prisma/client package's resolved directory, which under
// pnpm is the .pnpm store — TS can't resolve `.prisma/client/default`
// from there). The output path is gitignored.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL_DIRECT")
}

// ============================================================================
// Auth.js v5 (next-auth) — Postgres adapter shapes.
// https://authjs.dev/getting-started/adapters/prisma
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String  @map("user_id")
  type                     String
  provider                 String
  providerAccountId        String  @map("provider_account_id")
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Mapped to `auth_sessions` (not `sessions`) so the next-auth adapter
// table doesn't collide with the domain `sessions` table that Alembic
// migration 0003 introduces (brief §10.1 — moderated sessions).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Domain — moderated sessions, participants, utterances.
// Mirror of Alembic migration 0003_phase1_persistence (engine side).
// Engine owns DDL; this file is the typed read/write surface for web.
//
// The model is named `ModeratedSession` (not `Session`) because the
// Auth.js Prisma adapter reserves the `Session` model name above for
// browser sessions. The underlying table is still `sessions` per the
// brief's schema (§10.1).
// ============================================================================

model ModeratedSession {
  id                          String    @id @default(uuid()) @db.Uuid
  studyId                     String?   @map("study_id") @db.Uuid
  status                      String    @default("scheduled")
  scheduledStart              DateTime? @map("scheduled_start") @db.Timestamptz(6)
  actualStart                 DateTime? @map("actual_start") @db.Timestamptz(6)
  actualEnd                   DateTime? @map("actual_end") @db.Timestamptz(6)
  livekitRoomName             String    @unique(map: "uq_sessions_livekit_room_name") @map("livekit_room_name")
  configSnapshot              Json      @default("{}") @map("config_snapshot") @db.JsonB
  recordingUrl                String?   @map("recording_url")
  perParticipantRecordingUrls Json?     @map("per_participant_recording_urls") @db.JsonB
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Nullable FK so a study purge keeps historical sessions intact —
  // their `configSnapshot` is the authoritative record at that point.
  study             Study?             @relation(fields: [studyId], references: [id], onDelete: SetNull, map: "fk_sessions_study_id_studies")
  participants      Participant[]
  utterances        Utterance[]
  stateSnapshots    StateSnapshot[]
  decisions         Decision[]
  researcherActions ResearcherAction[]
  sessionFlags      SessionFlag[]

  @@index([studyId], map: "ix_sessions_study_id")
  @@index([status], map: "ix_sessions_status")
  @@map("sessions")
}

model Participant {
  id              String    @id @default(uuid()) @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  displayName     String    @map("display_name")
  role            String
  joinedAt        DateTime? @map("joined_at") @db.Timestamptz(6)
  leftAt          DateTime? @map("left_at") @db.Timestamptz(6)
  livekitIdentity String    @map("livekit_identity")

  session            ModeratedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_participants_session_id_sessions")
  utterances         Utterance[]
  targetedDecisions  Decision[]

  @@unique([sessionId, livekitIdentity], map: "uq_participants_session_id_livekit_identity")
  @@index([sessionId], map: "ix_participants_session_id")
  @@map("participants")
}

model Utterance {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  startTs       DateTime @map("start_ts") @db.Timestamptz(6)
  endTs         DateTime @map("end_ts") @db.Timestamptz(6)
  text          String
  confidence    Float?   @db.Real
  isFinal       Boolean  @map("is_final")

  session     ModeratedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_utterances_session_id_sessions")
  participant Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade, map: "fk_utterances_participant_id_participants")

  @@index([sessionId, startTs], map: "ix_utterances_session_id_start_ts")
  @@index([participantId, startTs], map: "ix_utterances_participant_id_start_ts")
  @@map("utterances")
}

// ============================================================================
// State snapshots — full SessionState per tick (brief §10.1).
// Mirror of Alembic migration 0004_state_snapshots (engine side).
// Web reads from this table to backfill the SSE stream on reconnect
// (last-event-id resolution).
// ============================================================================

model StateSnapshot {
  id        String   @id(map: "pk_state_snapshots") @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  tickId    BigInt   @map("tick_id")
  ts        DateTime @db.Timestamptz(6)
  state     Json     @db.JsonB

  session ModeratedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_state_snapshots_session_id_sessions")

  @@index([sessionId, tickId], map: "ix_state_snapshots_session_id_tick_id")
  @@map("state_snapshots")
}

// ============================================================================
// Decisions + rule evaluations — moderator audit trail (brief §10.1).
// Mirror of Alembic migration 0005_decisions_rule_evals (engine side).
// The dashboard's decision log and "Why quiet now?" panel read these
// directly via the SSE backfill route.
// ============================================================================

model Decision {
  id                  String    @id @default(uuid()) @db.Uuid
  sessionId           String    @map("session_id") @db.Uuid
  tickId              BigInt    @map("tick_id")
  ts                  DateTime  @db.Timestamptz(6)
  action              String
  targetParticipantId String?   @map("target_participant_id") @db.Uuid
  source              String
  triggeringRule      String?   @map("triggering_rule")
  researcherId        String?   @map("researcher_id") @db.Uuid
  researcherHint      String?   @map("researcher_hint")
  // text[] in Postgres; Prisma maps natively as `String[]`.
  reasonCodes         String[]  @default([]) @map("reason_codes")
  reasonHuman         String    @default("") @map("reason_human")
  confidence          Float?    @db.Real
  suppressedBy        String[]  @default([]) @map("suppressed_by")
  wasExecuted         Boolean   @map("was_executed")
  llmPrompt           Json?     @map("llm_prompt") @db.JsonB
  llmOutput           String?   @map("llm_output")
  ttsAudioUrl         String?   @map("tts_audio_url")
  spokenAt            DateTime? @map("spoken_at") @db.Timestamptz(6)
  cooldownUntil       DateTime  @map("cooldown_until") @db.Timestamptz(6)

  session            ModeratedSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_decisions_session_id_sessions")
  targetParticipant  Participant?       @relation(fields: [targetParticipantId], references: [id], onDelete: SetNull, map: "fk_decisions_target_participant_id_participants")
  ruleEvaluations    RuleEvaluation[]
  // Researcher commands that produced this decision (force_prompt,
  // force_redirect, force_summary, whisper). Non-spoken commands leave
  // resulting_decision_id null and don't appear here.
  researcherActions  ResearcherAction[]

  @@index([sessionId, ts], map: "ix_decisions_session_id_ts")
  // Partial index — `was_executed = true` only, per migration. Prisma
  // can't model partial indexes, but the @@index declaration keeps the
  // composite covered for type-level reasoning.
  @@index([sessionId, wasExecuted], map: "ix_decisions_session_id_was_executed_true")
  @@map("decisions")
}

model RuleEvaluation {
  id               String  @id @default(uuid()) @db.Uuid
  decisionId       String  @map("decision_id") @db.Uuid
  ruleName         String  @map("rule_name")
  ruleVersion      String  @map("rule_version")
  fired            Boolean
  suppressedReason String? @map("suppressed_reason")
  predicateInputs  Json    @default("{}") @map("predicate_inputs") @db.JsonB
  confidence       Float   @default(0.0) @db.Real

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade, map: "fk_rule_evaluations_decision_id_decisions")

  @@index([decisionId], map: "ix_rule_evaluations_decision_id")
  @@map("rule_evaluations")
}

// ============================================================================
// Studies — reusable session configurations (brief §10.1, §7.5).
// Mirror of Alembic migration 0006_studies_table (engine side).
//
// A study bundles the research prompt, the rules config + version, the
// moderator persona, and the retention policy. At session start the
// engine snapshots these into `sessions.config_snapshot` so replay
// reads the frozen bundle, not the live row (a researcher editing a
// study tomorrow must not retroactively change yesterday's session).
//
// `prompt_embedding` is deferred — pgvector isn't installed yet, and
// the topic_drift rule re-embeds in-process. Stored as JSONB so a
// future migration can either populate it or drop the column without
// a data-loss path.
// ============================================================================

model Study {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  name             String
  prompt           String
  // Deferred pgvector column — see Alembic 0006 docstring.
  promptEmbedding  Json?    @map("prompt_embedding") @db.JsonB
  rulesConfig      Json     @default("{}") @map("rules_config") @db.JsonB
  rulesVersion     String   @map("rules_version")
  moderatorPersona Json     @default("{}") @map("moderator_persona") @db.JsonB
  retentionPolicy  Json     @default("{}") @map("retention_policy") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Auth.js user UUID; not an FK because the engine doesn't own the
  // users table and the web service can recreate Auth.js tables out
  // of band. Storing the raw UUID preserves audit without coupling.
  createdBy        String   @map("created_by") @db.Uuid

  sessions ModeratedSession[]

  @@index([orgId], map: "ix_studies_org_id")
  @@map("studies")
}

// ============================================================================
// Researcher actions + session flags — Phase 5 control plane (brief §10.1).
// Mirror of Alembic migration 0007_researcher_actions_flags (engine side).
//
// `researcher_actions` records every researcher-issued command on a
// session (force_prompt, whisper, mute, pause, …). Spoken commands
// link back via `resultingDecisionId` to the `decisions` row they
// produced; non-spoken control commands leave that null.
//
// `session_flags` records bookmark moments — either researcher-flagged
// via the `flag_moment` command, or auto-generated by the engine. The
// `autoGenerated` boolean distinguishes the two for the replay UI.
//
// `researcherId` is the Auth.js user UUID. Not an FK (same rationale
// as `studies.createdBy`): the engine doesn't own the users table.
// ============================================================================

model ResearcherAction {
  id                  String    @id(map: "pk_researcher_actions") @default(uuid()) @db.Uuid
  sessionId           String    @map("session_id") @db.Uuid
  researcherId        String    @map("researcher_id") @db.Uuid
  ts                  DateTime  @db.Timestamptz(6)
  commandType         String    @map("command_type")
  payload             Json?     @db.JsonB
  resultingDecisionId String?   @map("resulting_decision_id") @db.Uuid

  session           ModeratedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_researcher_actions_session_id_sessions")
  resultingDecision Decision?        @relation(fields: [resultingDecisionId], references: [id], onDelete: SetNull, map: "fk_researcher_actions_resulting_decision_id_decisions")

  @@index([sessionId, ts], map: "ix_researcher_actions_session_id_ts")
  @@map("researcher_actions")
}

model SessionFlag {
  id            String    @id(map: "pk_session_flags") @default(uuid()) @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  ts            DateTime  @db.Timestamptz(6)
  researcherId  String?   @map("researcher_id") @db.Uuid
  note          String?
  autoGenerated Boolean   @default(false) @map("auto_generated")

  session ModeratedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_session_flags_session_id_sessions")

  @@index([sessionId, ts], map: "ix_session_flags_session_id_ts")
  @@map("session_flags")
}
