# ─────────────────────────────────────────────────────────────
# verbio-web — environment variables
#
# Copy to .env.local for local development. Production values
# live in Vercel project settings, scoped per environment
# (preview / staging / production).
# ─────────────────────────────────────────────────────────────

# Runtime mode. Next.js sets NODE_ENV automatically (development /
# production / test); list here only for documentation.
NODE_ENV=development

# Canonical public URL of the deployed app. Used by Auth.js for
# callback URLs and by SSE reconnection logic. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Branding override surfaced in the browser title and header.
NEXT_PUBLIC_APP_NAME=Verbio

# ─────── Database (Railway Postgres) ───────
# Pooled (pgBouncer transaction mode, port 6543) — used by every
# serverless request handler. Required.
DATABASE_URL_POOLED=postgresql://verbio:password@localhost:6543/verbio?pgbouncer=true

# Direct (port 5432) — used only by `prisma db pull` to introspect
# the live schema. Optional in production runtime; required for
# `pnpm db:pull` workflows.
DATABASE_URL_DIRECT=postgresql://verbio:password@localhost:5432/verbio

# ─────── Redis (Railway addon, TLS) ───────
REDIS_URL=rediss://default:password@localhost:6379

# Namespace prefix applied to every Verbio Redis key / stream /
# channel. Use one namespace per Vercel environment so previews
# don't trample production.
REDIS_NAMESPACE=verbio:local

# ─────── Auth.js v5 ───────
# Cryptographic secret for session cookies + CSRF tokens. Generate
# with `openssl rand -base64 32`. Required in every environment.
AUTH_SECRET=

# Resend API key for magic-link email delivery.
AUTH_RESEND_KEY=

# Verified sender on Resend, e.g. "Verbio <auth@verbio.app>".
AUTH_EMAIL_FROM=

# ─────── Cloudflare R2 (recording storage) ───────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=verbio-recordings-local
R2_PUBLIC_BASE_URL=

# ─────── Engine (verbio-engine on Railway) ───────
# Base URL of the engine's FastAPI admin surface. Web calls this
# to spawn / supervise sessions.
ENGINE_BASE_URL=http://localhost:8000

# Shared secret required on every web → engine admin request.
# Engine validates against its own ADMIN_TOKEN. Generate with
# `openssl rand -base64 32` and provision identically on both.
ENGINE_ADMIN_TOKEN=

# ─────── LiveKit (SFU) ───────
# Browser-side WS URL — issued to participants in their join token.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
# Server-side base URL for the LiveKit REST API (AgentDispatch).
# Same host as NEXT_PUBLIC_LIVEKIT_URL but the SDK accepts wss:// too.
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
